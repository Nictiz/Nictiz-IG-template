<div xmlns="http://www.w3.org/1999/xhtml">
  <table class="grid">
    <thead>
    <tr>
        <th>Id</th>
        <th>Naam</th>
        <th>Omschrijving</th>
        <th>Bronnen</th>
    </tr>
    </thead>
    <tbody>
    {% for i in Requirements.statement %}
        <tr id="{{i.key}}" >
        <td><a href="#{{i.key}}">{{i.key.replaceMatches('[^\\.]', '').replace('.', '&nbsp;&nbsp;&nbsp;&nbsp;')}}{{i.key}}</a></td>
        <td {% if i.label.startsWith('EU') %}class="req-origin-eu"{% endif %}>{{i.label}}</td>
        <td>{{i.requirement || markdownify}}</td>
        <td>{% for source in i.source %}{% if i.source.reference %}<a href="{{i.source.reference}}">{% endif %}{{i.source.display}}{% if i.source.reference %}</a>{% endif %}{% endfor %}
        </tr>
    {% endfor %}
    </tbody>
  </table>
</div>